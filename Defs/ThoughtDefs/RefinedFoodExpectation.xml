<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Acquired by RefinedFoodExpectationPatch only after a successfully ingested Grains meal. -->
  <ThoughtDef>
    <defName>AMJ_ExpectedRefinedFoodBrown</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li>
      <label>expected finer rice</label>
      <description>With our stores secure, I had hoped for better-prepared rice.</description>
      <baseMoodEffect>-1</baseMoodEffect>
    </li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>AMJ_ExpectedRefinedFoodCoarse</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li>
      <label>expected a finer meal</label>
      <description>We have plenty, yet I was served plain coarse grains.</description>
      <baseMoodEffect>-2</baseMoodEffect>
    </li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>AMJ_GourmandCoarseRice</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li>
      <label>uninspired rice meal</label>
      <description>We have plenty of food. Surely we can prepare something finer.</description>
      <baseMoodEffect>-2</baseMoodEffect>
    </li></stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>AMJ_GourmandCoarseGrains</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages><li>
      <label>uninspired grain meal</label>
      <description>With our abundant stores, a plain bowl of grains is disappointing.</description>
      <baseMoodEffect>-3</baseMoodEffect>
    </li></stages>
  </ThoughtDef>
</Defs>
