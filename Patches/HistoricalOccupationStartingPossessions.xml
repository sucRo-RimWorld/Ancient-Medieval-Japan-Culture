<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Only newly assigned starting possessions on six historically rewritten
       Vanilla BackstoryDefs are adjusted; no stored Pawn gear, saved Things,
       Trait, Need or medicine/meal ThingDef is removed or rewritten. The
       optional Odyssey-only item uses a conditional guard. -->
  <!-- DeepSpaceMiner3: Odyssey-gated asteroid block → ordinary mined metal; do nothing when original optional content is absent. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BackstoryDef[defName="DeepSpaceMiner3"]/possessions/li[thingDef="BlocksVacstone"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/BackstoryDef[defName="DeepSpaceMiner3"]/possessions/li[thingDef="BlocksVacstone"]</xpath>
      <value>
        <li>
          <thingDef>Steel</thingDef>
          <count>20</count>
        </li>
      </value>
    </match>
  </Operation>
  <!-- Engineer40: 3 industrial components → 30 units of generic metal stock. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/BackstoryDef[defName="Engineer40"]/possessions/li[thingDef="ComponentIndustrial"]</xpath>
    <value>
      <li>
        <thingDef>Steel</thingDef>
        <count>30</count>
      </li>
    </value>
  </Operation>
  <!-- SpaceNavyDoctor72: 10 prophylactic pills → 10 herbal medical supplies. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/BackstoryDef[defName="SpaceNavyDoctor72"]/possessions/li[thingDef="Penoxycyline"]</xpath>
    <value>
      <li>
        <thingDef>MedicineHerbal</thingDef>
        <count>10</count>
      </li>
    </value>
  </Operation>
  <!-- SpaceshipChef41: 4 nutrient-paste meals → 4 ordinary meals. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/BackstoryDef[defName="SpaceshipChef41"]/possessions/li[thingDef="MealNutrientPaste"]</xpath>
    <value>
      <li>
        <thingDef>MealSimple</thingDef>
        <count>4</count>
      </li>
    </value>
  </Operation>
  <!-- StarshipDoctor37: 2 glitterworld medicine → 2 herbal medicine. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/BackstoryDef[defName="StarshipDoctor37"]/possessions/li[thingDef="MedicineUltratech"]</xpath>
    <value>
      <li>
        <thingDef>MedicineHerbal</thingDef>
        <count>2</count>
      </li>
    </value>
  </Operation>
  <!-- WanderingHealer52: 3 manufactured medicine → 3 herbal medicine. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/BackstoryDef[defName="WanderingHealer52"]/possessions/li[thingDef="MedicineIndustrial"]</xpath>
    <value>
      <li>
        <thingDef>MedicineHerbal</thingDef>
        <count>3</count>
      </li>
    </value>
  </Operation>
</Patch>
