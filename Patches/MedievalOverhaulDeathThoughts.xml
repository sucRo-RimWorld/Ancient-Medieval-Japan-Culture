<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Retain ordinary battlefield corpse familiarity without blanket immunity to
       grief, lethal banishment, prisoner treatment or rotting remains. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Medieval Overhaul</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThoughtDef[defName="PawnWithGoodOpinionDied"]/nullifyingTraits/li[.="DankPyon_Fighter" or .="DankPyon_Veteran"]</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/ThoughtDef[defName="PawnWithGoodOpinionDied"]/nullifyingTraits/li[.="DankPyon_Fighter" or .="DankPyon_Veteran"]</xpath>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThoughtDef[defName="KnowPrisonerDiedInnocent"]/nullifyingTraits/li[.="DankPyon_Fighter" or .="DankPyon_Veteran"]</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/ThoughtDef[defName="KnowPrisonerDiedInnocent"]/nullifyingTraits/li[.="DankPyon_Fighter" or .="DankPyon_Veteran"]</xpath>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThoughtDef[defName="KnowGuestExecuted"]/nullifyingTraits/li[.="DankPyon_Veteran"]</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/ThoughtDef[defName="KnowGuestExecuted"]/nullifyingTraits/li[.="DankPyon_Veteran"]</xpath>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThoughtDef[defName="WitnessedDeathAlly"]/nullifyingTraits/li[.="DankPyon_Veteran"]</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/ThoughtDef[defName="WitnessedDeathAlly"]/nullifyingTraits/li[.="DankPyon_Veteran"]</xpath>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThoughtDef[defName="ColonistBanishedToDie"]/nullifyingTraits/li[.="DankPyon_Veteran"]</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/ThoughtDef[defName="ColonistBanishedToDie"]/nullifyingTraits/li[.="DankPyon_Veteran"]</xpath>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThoughtDef[defName="PrisonerBanishedToDie"]/nullifyingTraits/li[.="DankPyon_Veteran"]</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/ThoughtDef[defName="PrisonerBanishedToDie"]/nullifyingTraits/li[.="DankPyon_Veteran"]</xpath>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThoughtDef[defName="ObservedLayingRottingCorpse"]/nullifyingTraits/li[.="DankPyon_Veteran"]</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/ThoughtDef[defName="ObservedLayingRottingCorpse"]/nullifyingTraits/li[.="DankPyon_Veteran"]</xpath>
          </match>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
