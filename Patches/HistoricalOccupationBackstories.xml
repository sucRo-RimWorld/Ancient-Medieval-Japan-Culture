<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Only historically portable careers. Preserve each BackstoryDef identifier,
       category, slot, forced Traits, skills, work rules and possessions. English
       source narrative is rewritten here; Japanese DefInjected is supplied below. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/BackstoryDef[defName="SpaceMerchant97"]/title</xpath>
    <value>
      <title>coastal merchant</title>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/BackstoryDef[defName="SpaceMerchant97"]/titleShort</xpath>
    <value>
      <titleShort>merchant</titleShort>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/BackstoryDef[defName="SpaceMerchant97"]/baseDesc</xpath>
    <value>
      <baseDesc>As a coastal trader, [PAWN_nameDef] moved goods between ports and market towns, bargaining for cargo and hiring boats when no vessel was available. Negotiation and practical repairs mattered as much as keeping an eye on rivals.</baseDesc>
    </value>
  </Operation>
