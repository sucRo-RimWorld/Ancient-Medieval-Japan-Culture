  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/BackstoryDef[defName="SpaceSmuggler6"]/baseDesc</xpath>
    <value>
      <baseDesc>As a child, [PAWN_nameDef] carried untaxed goods for the family, slipping past checkpoints and river crossings. The work taught bargaining, fighting to protect cargo, and tending wounds when a journey turned violent.</baseDesc>
    </value>
  </Operation>
