<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The original MO 1.6 alchemy mixtures inherit recipeMaker from the
       DankPyon_MixtureBase abstract ThingDef. Removing recipeMaker from the
       finished drug ThingDefs alone does NOT close this inherited bill route.
       Remove the base recipe maker and restore it on the three mixtures
       outside Culture's approved hard-drug exclusion. All eight ThingDefs
       remain present, including existing saved mixtures and process recipes. -->
  <Operation Class="PatchOperationFindMod">
    <mods><li>Medieval Overhaul</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[@Name="DankPyon_MixtureBase" and @Abstract="True"]/recipeMaker</xpath>
          <match Class="PatchOperationRemove">
            <xpath>Defs/ThingDef[@Name="DankPyon_MixtureBase" and @Abstract="True"]/recipeMaker</xpath>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DankPyon_Mixture_Miracle" or defName="DankPyon_Mixture_Paregoric" or defName="DankPyon_Mixture_Knowledge"]</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DankPyon_Mixture_Miracle" or defName="DankPyon_Mixture_Paregoric" or defName="DankPyon_Mixture_Knowledge"]</xpath>
            <value>
              <recipeMaker>
                <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
                <workSkill>Intellectual</workSkill>
                <effectWorking>Cook</effectWorking>
                <soundWorking>Recipe_CookMeal</soundWorking>
                <bulkRecipeCount>3</bulkRecipeCount>
                <researchPrerequisite>DankPyon_Alchemy</researchPrerequisite>
                <recipeUsers><li>DankPyon_AlchemyBench</li></recipeUsers>
              </recipeMaker>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
