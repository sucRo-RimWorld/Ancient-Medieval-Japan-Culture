<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Vanilla Core 1.6/1.7: these thirty adult BackstoryDefs have existing
       spawnCategories. Keep the BackstoryDef identities, traits, stats, skills
       and saved-pawn references. Restrict ordinary new generation only.
       This does not modify category-less Solid_Child biographies or forcibly
       assigned backgrounds, and does not claim protection from external mods. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/BackstoryDef[defName="AerospaceEngineer44"]/spawnCategories</xpath>
    <value>
      <spawnCategories>
        <li>AMJ_CultureExcluded</li>
      </spawnCategories>
    </value>
  </Operation>
