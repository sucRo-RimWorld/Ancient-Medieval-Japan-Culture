<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- MO's HappyPowder is a risky emergency mood drug, not a default
       combat consumable. Keep the existing item, player-directed ingestion,
       recipe/trade, chemical, addiction, tolerance, withdrawal and high effects.
       Only exclude this item from AI combat-enhancing drug selection. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Medieval Overhaul</li>
    </mods>
    <match Class="PatchOperationConditional">
      <xpath>Defs/ThingDef[defName="DankPyon_HappyPowder"]/comps/li[@Class="CompProperties_Drug"]/isCombatEnhancingDrug</xpath>
      <match Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="DankPyon_HappyPowder"]/comps/li[@Class="CompProperties_Drug"]/isCombatEnhancingDrug</xpath>
        <value>
          <isCombatEnhancingDrug>false</isCombatEnhancingDrug>
        </value>
      </match>
    </match>
  </Operation>
</Patch>
