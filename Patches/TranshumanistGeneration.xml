<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Suppress random assignment without deleting the TraitDef or affecting existing pawns. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/TraitDef[defName="Transhumanist"]/commonality</xpath>
    <value>
      <commonality>0</commonality>
    </value>
  </Operation>
  <!-- Forced Backstory assignment cannot be removed with this 1.6 XML xpath.
       Omit the failing operation until the actual Backstory storage path is fixed. -->
</Patch>
